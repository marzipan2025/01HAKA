claude_kanji/build/

# Build artifacts — the dmg is a release asset, never a tracked file.
# `dmg/make_dmg.sh` builds it into claude_kanji/dist/ and uploads it to the
# GitHub release; the in-app updater fetches it from there, not from the repo.
claude_kanji/dist/
*.dmg

.DS_Store

# 뿌리에 남는 DerivedData 와 Xcode 의 개인 설정. 소스가 아닌데도 남아 있으면
# make_dmg.sh 의 게시 관문(working tree is dirty)에 걸린다.
build/
xcuserdata/
